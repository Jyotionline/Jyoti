{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", ".*", "**/node_modules/**", "functions/**", "README_BN.txt"],
    "cleanUrls": true
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log"]
    }
  ],
  "firestore": { "rules": "firestore.rules" }
}